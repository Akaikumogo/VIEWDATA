{
  "name": "viewdata",
  "productName": "Viewdata",
  "version": "0.1.0",
  "description": "Desktop database explorer with live analytics and self-arranging schema diagrams for PostgreSQL, MySQL, MariaDB, Oracle and MongoDB",
  "main": "./out/main/index.js",
  "author": "Viewdata contributors",
  "license": "MIT",
  "keywords": [
    "database",
    "electron",
    "postgresql",
    "mysql",
    "mariadb",
    "oracle",
    "mongodb",
    "schema",
    "erd"
  ],
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "assets": "electron scripts/make-assets.cjs",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "app.viewdata.desktop",
    "productName": "Viewdata",
    "copyright": "Copyright © 2026 Viewdata contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!node_modules/sql.js/dist/!(sql-wasm.js|sql-wasm.wasm)",
      "!node_modules/oracledb/build/Release/!(*win32-x64*)",
      "!node_modules/@types/**",
      "!node_modules/**/*.{md,markdown,map,d.ts,d.mts,d.cts,flow}",
      "!node_modules/**/{test,tests,__tests__,docs,doc,example,examples,benchmark,benchmarks,.github}/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "build/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Viewdata-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Viewdata ${version}",
      "artifactName": "Viewdata-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Viewdata",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "license": "LICENSE",
      "artifactName": "Viewdata-Setup-${version}.exe",
      "uninstallDisplayName": "Viewdata"
    }
  },
  "dependencies": {
    "mariadb": "^3.5.4",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.5",
    "oracledb": "^7.0.1",
    "pg": "^8.23.1",
    "sql.js": "^1.14.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@types/node": "^26.6.4",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.12.0",
    "framer-motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
